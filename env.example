# ==============================================================================
# Configuración de Base de Datos PostgreSQL
# ==============================================================================
POSTGRES_USER=taller_user
POSTGRES_PASSWORD=cambiar_por_password_segura
POSTGRES_DB=taller_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ==============================================================================
# Seguridad y Autenticación JWT
# ==============================================================================
JWT_SECRET_KEY=cambiar_por_clave_secreta_aleatoria_hex_o_base64
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=1800

# ==============================================================================
# Parámetros Operativos del Sistema
# ==============================================================================
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
BCRYPT_MAX_CONCURRENCY=4
DB_POOL_SIZE=10
SQL_ECHO=false
